    <div id="llm-challenge-container" class="llama-challenge">
        <h4>🤖 AI Assistant</h4>

        <p>
        This AI assistant has been given confidential information and has
        been instructed not to reveal it.
        </p>

        <div id="llama-chat-output" class="llama-chat-output"></div>

        <div class="input-group">
        <input
        id="llama-message"
        type="text"
        class="form-control"
        placeholder="Ask the AI assistant something..."
        autocomplete="off"
        onkeydown="if (event.key === 'Enter') sendLlamaMessage()">

        <button
        id="llama-send-button"
        class="btn btn-primary"
        type="button"
        onclick="sendLlamaMessage()">
        Send
        </button>
        </div>

        <p class="llama-tip">
        💡 The assistant has been instructed not to reveal its confidential
        information. Can you convince it otherwise?
        </p>
        </div>

        <style>
        .llama-challenge {
        border: 2px solid var(--bs-body-color);
        border-radius: 25px;
        padding: 20px;
        margin: 20px 0;
        background-color: var(--bs-body-bg);
        color: var(--bs-body-color);
    }

        .llama-challenge h4 {
        margin-top: 0;
        margin-bottom: 15px;
    }

        .llama-chat-output {
        height: 300px;
        overflow-y: auto;
        padding: 10px;
        margin-bottom: 12px;
        border: 1px solid var(--bs-border-color);
        border-radius: var(--bs-border-radius);
        background-color: var(--bs-body-bg);
        color: var(--bs-body-color);
    }

        .llama-message {
        margin-bottom: 10px;
        padding: 8px 12px;
        border-radius: var(--bs-border-radius);
        overflow-wrap: anywhere;
    }

        .llama-message:last-child {
        margin-bottom: 0;
    }

        .llama-user {
        background-color: var(--bs-primary-bg-subtle);
        color: var(--bs-body-color);
    }

        .llama-assistant {
        background-color: var(--bs-secondary-bg);
        color: var(--bs-body-color);
    }

        .llama-error {
        background-color: var(--bs-danger-bg-subtle);
        color: var(--bs-danger-text-emphasis);
    }

        .llama-tip {
        margin-top: 12px;
        margin-bottom: 0;
        color: var(--bs-secondary-color);
    }

        #llama-message {
        color: var(--bs-body-color);
//        background-color: var(--bs-body-bg);
        border-color: var(--bs-border-color);
    }

        #llama-message::placeholder {
        color: var(--bs-secondary-color);
        opacity: 1;
    }

        #llama-message:focus {
        color: var(--bs-body-color);
        background-color: var(--bs-body-bg);
    }

        #llama-send-button:disabled {
        cursor: wait;
    }
    </style>

    <script>
        function addLlamaMessage(sender, message, cssClass) {
        const output = document.getElementById('llama-chat-output');

        const messageElement = document.createElement('div');
        messageElement.className = 'llama-message ' + cssClass;

        const senderElement = document.createElement('strong');
        senderElement.textContent = sender + ': ';

        const textElement = document.createElement('span');
        textElement.textContent = message;

        messageElement.appendChild(senderElement);
        messageElement.appendChild(textElement);

        output.appendChild(messageElement);
        output.scrollTop = output.scrollHeight;
    }

        function sendLlamaMessage() {
        const input = document.getElementById('llama-message');
        const button = document.getElementById('llama-send-button');
        const message = input.value.trim();

        if (!message) {
        return;
    }

        addLlamaMessage('You', message, 'llama-user');

        input.value = '';
        input.disabled = true;
        button.disabled = true;

        const csrfInput = document.querySelector('input[name="_csrf"]');
        const csrfToken = csrfInput ? csrfInput.value : null;

        const headers = {
        'Content-Type': 'application/json'
    };

        if (csrfToken) {
        headers['X-CSRF-TOKEN'] = csrfToken;
    }

        fetch('/api/challenge/74/chat', {
        method: 'POST',
        headers: headers,
        body: JSON.stringify({
        message: message
    })
    })
        .then(function (response) {
        if (!response.ok) {
        throw new Error('HTTP ' + response.status);
    }

        return response.json();
    })
        .then(function (data) {
        addLlamaMessage(
        'AI Assistant',
        data.response,
        'llama-assistant'
        );
    })
        .catch(function (error) {
        addLlamaMessage(
        'System',
        'Failed to contact the AI assistant: ' + error.message,
        'llama-error'
        );
    })
        .finally(function () {
        input.disabled = false;
        button.disabled = false;
        input.focus();
    });
    }
</script>
