    <div id="llm-challenge-container" style="border: 1px solid #ccc; border-radius: 8px; padding: 20px; margin: 20px; background-color: #f9f9f9;">
        <h4>🤖 AI Assistant</h4>

        <p>
        This AI assistant has been given confidential information and has
        been instructed not to reveal it.
        </p>

        <div id="llama-chat-output"
        style="height: 300px; overflow-y: auto; padding: 10px; margin-bottom: 12px; border: 1px solid #dee2e6; border-radius: 4px; background-color: #fff;">
        </div>

        <div class="input-group">
        <input id="llama-message"
        type="text"
        class="form-control"
        placeholder="Ask the AI assistant something..."
        onkeydown="if (event.key === 'Enter') sendLlamaMessage()">

        <button class="btn btn-primary"
        type="button"
        onclick="sendLlamaMessage()">
        Send
        </button>
        </div>

        <p style="margin-top: 12px;">
        <small class="skill-tip">
        💡 The assistant has been instructed not to reveal its confidential
        information. Can you convince it otherwise?
        </small>
        </p>
        </div>

        <style>
        .llama-message {
        margin-bottom: 10px;
        padding: 8px 12px;
        border-radius: 6px;
    }

        .llama-user {
        background-color: #e7f1ff;
    }

        .llama-assistant {
        background-color: #f1f3f5;
    }

        .llama-error {
        background-color: #f8d7da;
    }
        </style>

        <script>
        function addLlamaMessage(sender, message, cssClass) {
        const output = document.getElementById('llama-chat-output');

        const messageElement = document.createElement('div');
        messageElement.className = 'llama-message ' + cssClass;

        const senderElement = document.createElement('strong');
        senderElement.textContent = sender + ': ';

        const textElement = document.createElement('span');
        textElement.textContent = message;

        messageElement.appendChild(senderElement);
        messageElement.appendChild(textElement);

        output.appendChild(messageElement);
        output.scrollTop = output.scrollHeight;
    }

        function sendLlamaMessage() {
        const input = document.getElementById('llama-message');
        const message = input.value.trim();

        if (!message) {
        return;
    }

        addLlamaMessage('You', message, 'llama-user');
        input.value = '';

        fetch('/api/challenge/74/chat', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json'
    },
        body: JSON.stringify({
        message: message
    })
    })
        .then(function(response) {
        if (!response.ok) {
        throw new Error('HTTP ' + response.status);
    }
        return response.json();
    })
        .then(function(data) {
        addLlamaMessage(
        'AI Assistant',
        data.response,
        'llama-assistant'
        );
    })
        .catch(function(error) {
        addLlamaMessage(
        'System',
        'Failed to contact the AI assistant: ' + error.message,
        'llama-error'
        );
    });
    }
</script>
